# Supabase Project Configuration
# Replace these with your new Supabase project details from your Supabase dashboard (Project Settings > API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side Supabase keys
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Database Connection String (for migrations / direct pooling)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Public site origin for printed QR codes (e.g. your Vercel deployment URL)
VITE_PUBLIC_SITE_URL="https://tapifyyy.vercel.app"

# Cron secret for scheduled jobs
CRON_SECRET="your-cron-secret-token"

